# Copia este archivo a .env (NO subas .env a git).
# JWT_SECRET es obligatorio: la app no arranca si falta o si es un valor de ejemplo.
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/PrevenRED2?retryWrites=true&w=majority
MONGO_DB_NAME=PrevenRED2
MONGO_TEST_URI=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# development, o MFA_ENABLED=false, permite el login de administrador sin el segundo factor.
ENVIRONMENT=development
MFA_ENABLED=false
